{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/bitacora-evidencias.db"
  },
  "Storage": {
    "RootPath": "Storage",
    "RequestPath": "/media",
    "ThumbnailWidth": 320,
    "ThumbnailHeight": 320,
    "MaxUploadMegabytes": 8,
    "MaxImageDimension": 2000,
    "JpegQuality": 78
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "RequireHttpsCookies": true,
    "EnableHttpsRedirection": true,
    "ProtectExistingData": false
  },
  "SensitiveDataProtection": {
    "KeyEnvironmentVariable": "BITACORA_DATA_PROTECTION_KEY"
  },
  "AllowedHosts": "*"
}
