# Local development example. Do not store real production secrets here.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://127.0.0.1:5067

# SQLite database used by the app.
ConnectionStrings__DefaultConnection=Data Source=Data/bitacora-evidencias.dev.db

# Evidence file storage.
Storage__RootPath=Storage
Storage__RequestPath=/media
Storage__ThumbnailWidth=320
Storage__ThumbnailHeight=320
Storage__MaxUploadMegabytes=8
Storage__MaxImageDimension=2000
Storage__JpegQuality=78

# Startup helpers. Use true only when explicitly preparing local data.
Startup__PrepareApplicationData=false
Startup__ExitAfterPrepareApplicationData=false
Startup__ResetApplicationData=false
Startup__AllowLegacySchemaWithoutMigrations=false

# Security settings.
Security__RequireHttpsCookies=true
Security__EnableHttpsRedirection=true
Security__ProtectExistingData=false

# Optional bootstrap password for the first admin user.
# Leave empty to let the app generate a temporary password without logging it.
Security__BootstrapAdminPassword=

# Sensitive-data protection key. Use a local test value only.
BITACORA_DATA_PROTECTION_KEY=change_me_to_a_local_32_byte_or_base64_key

# HTTPS certificate variables used by LAN/deployment scripts.
BITACORA_HTTPS_CERT_PATH=C:\path\to\local-development-certificate.pfx
BITACORA_HTTPS_CERT_PASSWORD=your_local_certificate_password

# Optional backup root for operational scripts.
BITACORA_BACKUP_ROOT=C:\BitacoraEvidencias\BackupsBitacora
