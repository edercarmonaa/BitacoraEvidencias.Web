{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Storage": {
    "RootPath": "Storage",
    "RequestPath": "/media",
    "ThumbnailWidth": 320,
    "ThumbnailHeight": 320,
    "MaxUploadMegabytes": 8,
    "MaxImageDimension": 2000,
    "JpegQuality": 78
  },
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "RequireHttpsCookies": true,
    "EnableHttpsRedirection": true
  }
}
