@page
@model BitacoraEvidencias.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Acceso";
}

<section class="login-shell">
    <div class="card shadow-sm login-card">
        <div class="card-body p-4">
            <h1 class="h4 mb-3">Iniciar sesión</h1>
            <p class="text-muted small mb-4">Sesión de 30 minutos por inactividad.</p>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert app-alert-error" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" data-ui-loading>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Input.Usuario" class="form-label"></label>
                    <input asp-for="Input.Usuario" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.Usuario" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Contrasena" class="form-label"></label>
                    <input asp-for="Input.Contrasena" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Contrasena" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <span class="btn-label">Entrar</span>
                    <span class="btn-loading" aria-hidden="true">
                        <span class="btn-loading-dot"></span>
                        Ingresando...
                    </span>
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
