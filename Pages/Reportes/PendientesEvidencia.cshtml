@page
@model BitacoraEvidencias.Web.Pages.Reportes.PendientesEvidenciaModel
@{
    ViewData["Title"] = "Pendientes de evidencia";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Pendientes de evidencia</h1>
        <small class="text-muted">Listado completo de casos sin evidencias cargadas ni imagen enlazada.</small>
    </div>
    <a class="btn btn-outline-secondary"
       asp-page="/Reportes"
       hx-get="@Url.Page("/Reportes")"
       hx-target="#app-main"
       hx-select="#app-main"
       hx-swap="outerHTML transition:true"
       hx-push-url="true">Volver a reportes</a>
</div>

@{
    var pager = new BitacoraEvidencias.Web.Pages.Shared.PaginationViewModel
    {
        PageNumber = Model.PageNumber,
        TotalPages = Model.TotalPages,
        PageSize = Model.PageSize,
        TotalRows = Model.TotalRows,
        CurrentCount = Model.Items.Count,
        PageName = "/Reportes/PendientesEvidencia",
        RowsLabel = "pendiente(s)",
        MaxPageSizeText = $"Máximo {Model.MaxAllowedPageSize} por página.",
        RouteValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase),
        UseHtmx = true,
        HxTarget = "#app-main",
        HxSelect = "#app-main",
        HxSwap = "outerHTML transition:true",
        HxPushUrl = true
    };
}

<partial name="_Pager" model="pager" />

<div class="table-responsive">
    <table class="table table-zebra-white table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Oficio</th>
                <th>Caso</th>
                <th>Nivel</th>
                <th>Tipo</th>
                <th>CURP</th>
                <th>Estatus</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                        Todos los casos tienen al menos una evidencia o imagen enlazada.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.NumeroOficio</td>
                        <td>@item.ConsecutivoTexto</td>
                        <td>@item.NivelEducativo</td>
                        <td>@item.TipoCorreccion</td>
                        <td>@(string.IsNullOrWhiteSpace(item.Curp) ? "-" : item.Curp)</td>
                        <td>@item.Estatus</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="pager" />
